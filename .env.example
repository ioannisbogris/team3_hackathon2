# --- Azure OpenAI chat model (required) ---
AZURE_OPENAI_API_KEY=key
AZURE_OPENAI_ENDPOINT="https://....openai.azure.com/"
OPENAI_API_VERSION=version
AZURE_OPENAI_DEPLOYMENT_NAME=model_name

# --- Azure OpenAI embeddings (required, used by the vector store) ---
AZURE_EMBEDDING_ENDPOINT="https://....openai.azure.com/"
AZURE_EMBEDDING_API_KEY=key
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=embedding_model_name
AZURE_OPENAI_API_VERSION=version

# --- Langfuse (works as-is with docker compose) ---
# Any pk-lf-/sk-lf- values work: the bundled Langfuse creates a project with exactly these keys on first start.
LANGFUSE_PUBLIC_KEY=pk-lf-team3-local
LANGFUSE_SECRET_KEY=sk-lf-team3-local
LANGFUSE_HOST=http://localhost:3000

# Langfuse first-start bootstrap (org, project, keys and a login for http://localhost:3000)
LANGFUSE_INIT_ORG_ID=team3
LANGFUSE_INIT_ORG_NAME=Team3
LANGFUSE_INIT_PROJECT_ID=vendor-risk-agent
LANGFUSE_INIT_PROJECT_NAME=Vendor Risk Agent
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=${LANGFUSE_PUBLIC_KEY}
LANGFUSE_INIT_PROJECT_SECRET_KEY=${LANGFUSE_SECRET_KEY}
LANGFUSE_INIT_USER_EMAIL=admin@team3.local
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=team3-admin-password
